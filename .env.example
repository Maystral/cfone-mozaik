# Copy to .env. With no key CFOne runs offline with a scripted model.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CFONE_OPENAI_BASE_URL=http://localhost:11434/v1
# CFONE_MODEL=
# CFONE_FAST_MODEL=
# CFONE_OFFLINE=1
CFONE_AS_OF=2026-11-05
CFONE_HOME_CURRENCY=AED
CFONE_BUFFERS=AED=500.00,EUR=100.00
# Mozaik Cloud is off without a key; keep content redacted if you turn it on.
# MOZAIK_API_KEY=
MOZAIK_REDACTION=content
