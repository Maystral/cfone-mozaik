    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@mozaik-ai/core": "4.2.0",
    "dotenv": "17.4.2",
    "pdfkit": "0.17.2",
    "tsx": "4.23.15",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pdfkit": "0.17.7",
    "typescript": "~5.9.3"
  }
