{
  "name": "cfone",
  "version": "0.1.0",
  "description": "A team of agents that closes a household's books from bank statements and warns before a cheque bounces. Built on Mozaik.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "demo": "tsx src/cli.ts",
    "start": "tsx src/server.ts",
